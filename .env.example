APP_ENV=development
APP_PORT=8000

MYSQL_DATABASE=codestreak
MYSQL_USER=codestreak_user
MYSQL_PASSWORD=replace_with_a_secure_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_secure_password
MYSQL_HOST=db
MYSQL_PORT=3306

# Use localhost when running FastAPI directly on Windows.
# Docker Compose overrides this with a URL using the db service hostname.
DATABASE_URL=mysql+pymysql://codestreak_user:replace_with_a_secure_password@localhost:3306/codestreak

GEMINI_API_KEY=
